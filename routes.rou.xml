<?xml version="1.0" encoding="UTF-8"?>

<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================== VEHICLE TYPES ================== -->

    <!-- Ambulance -->
    <vType id="ambulance"
           accel="3.0"
           decel="4.5"
           length="5"
           maxSpeed="40"
           guiShape="emergency"
           vClass="emergency"
           color="1,0,0"/>

    <!-- Normal Cars -->
    <vType id="car"
           accel="1.0"
           decel="4.5"
           length="5"
           maxSpeed="8"
           minGap="1"
           tau="2.5"
           vClass="passenger"
           color="1,1,0"/>
		   
		   <!-- Blue Cars -->
    <vType id="car_blue"
           accel="1.0"
           decel="4.5"
           length="5"
           maxSpeed="8"
           minGap="1"
           tau="2.5"
           vClass="passenger"
           color="0.15,0.45,1"/>

          <!-- Red Cars -->
    <vType id="car_red"
           accel="1.0"
           decel="4.5"
           length="5"
           maxSpeed="8"
           minGap="1"
           tau="2.5"
           vClass="passenger"
           color="0.9,0.15,0.15"/>
		   
		   
		   <!-- Heavy Trucks -->
    <vType id="truck"
           accel="0.8"
           decel="4.0"
           length="8"
           maxSpeed="7"
           minGap="2.5"
           tau="2.8"
           vClass="truck"
           guiShape="truck"
           color="0.3,0.3,0.3"/>
		   
		   <!-- Delivery Van -->
		   
	<vType id="delivery"
           accel="0.9"
           decel="4.2"
           length="7"
           maxSpeed="7"
           minGap="2"
           tau="2.8"
           guiShape="delivery"
           vClass="delivery"
           color="0.85,0.15,0.15"/>
		   
		   <!-- Bus -->
		   
	<vType id="bus"
           accel="0.7"
           decel="4.0"
           length="12"
           maxSpeed="7"
           minGap="3"
           tau="3"
           guiShape="bus"
           vClass="bus"
           color="0.15,0.4,1"/>

    <!-- ================== TRAFFIC FLOWS ================== -->

    <!-- Flow 1 -->
    <flow id="flow_1"
          type="car"
          begin="0"
          end="300"
          number="500"
          from="60825710#2"
          to="-615357552#2"/>
		  
		  <!-- Flow 1 (Blue Cars) -->
<flow id="flow_1_blue"
